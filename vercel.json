{
  "version": 2,
  "builds": [
    {
      "src": "reanime.py",
      "use": "@vercel/python",
      "config": {
        "entrypoint": "reanime:app"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "reanime.py"
    }
  ],
  "functions": {
    "reanime.py": {
      "maxDuration": 10
    }
  }
}
